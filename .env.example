# Only this one is needed to start. Buddy and AI questions then work locally with live web checking.
ANTHROPIC_API_KEY=
# Optional: choose another model
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: sign-in, saved progress and a stored question bank
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY= # paste the publishable key (sb_publishable_...) or legacy anon key
SUPABASE_SERVICE_ROLE_KEY= # paste the secret key (sb_secret_...) or legacy service_role key; server only
# Optional, free, no key: a local AI via Ollama (https://ollama.com) that writes friendly answers from the web results.
# Install Ollama, run `ollama pull llama3.2`, then uncomment the next line. Works on your own machine only (not on Vercel).
# OLLAMA_MODEL=llama3.2
